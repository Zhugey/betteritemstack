{
  "required": true,
  "minVersion": "0.8",
  "package": "com.zhugey.betteritemstack.mixin",
  "compatibilityLevel": "JAVA_17",
  "mixins": [
    "HopperBlockEntityMixin",
    "InventoryMixin",
    "ItemEntityMixin",
    "ItemStackMixin",
    "PacketByteBufMixin",
    "ServerPlayNetworkHandlerMixin",
    "SlotMixin"
  ],
  "injectors": {
    "defaultRequire": 1
  },
  "overwrites": {
    "requireAnnotations": true
  },
  "client": [
    "client.DrawContextMixin"
  ]
}
